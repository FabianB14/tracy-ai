# Get a key at https://console.anthropic.com (pay-as-you-go, no credit check)
ANTHROPIC_API_KEY=sk-ant-...

# Model Tracy runs on. Swap to claude-haiku-4-5 for cheaper high-volume tasks.
TRACY_MODEL=claude-sonnet-4-6

PORT=3000

# --- Web search & media (Tracy can look up current info) ---
# On by default. Set to "off" to disable web search entirely.
# TRACY_WEB_SEARCH=on
# Which engine backs web search: auto | gemini | anthropic.
#   auto (default) = Gemini if GEMINI_API_KEY is set, otherwise Anthropic.
# TRACY_SEARCH_PROVIDER=auto
# Cap on Anthropic searches per reply (cost control; ~$10 / 1000 searches).
# Only applies when the Anthropic engine is used.
# TRACY_WEB_SEARCH_MAX_USES=5

# --- Gemini (Google) — the "other brain" for search + media ---
# Optional. When set, Tracy uses Gemini + Google Search grounding for live web
# research, and gains an analyze_media tool for YouTube/audio/video links.
# Claude still runs the conversation, writing, and reasoning. Get a key at
# https://aistudio.google.com/apikey (generous free tier).
# GEMINI_API_KEY=...
# Gemini model to use. Default: gemini-2.5-flash (fast, free-tier friendly).
# GEMINI_MODEL=gemini-2.5-flash

# --- Knowledge base (RAG — Tracy's own growing memory) ---
# On automatically when GEMINI_API_KEY is set (used for embeddings). She
# retrieves relevant things she's learned before answering, and saves general
# (non-live) answers back so she reuses her own knowledge over time. Set off to
# disable. Seed it from docs with: node scripts/kb-ingest.js <files...>
# TRACY_KB=on
# GEMINI_EMBED_MODEL=gemini-embedding-2
#   Google retires embedding models on a schedule (text-embedding-004 died
#   2026-01-14, gemini-embedding-001 died 2026-07-14). If embeds start 404ing,
#   bump this. The server detects the change at boot and re-embeds all stored
#   knowledge + brain vectors automatically.
# GEMINI_EMBED_DIM=768  # optional smaller vectors; unset = model default
# Confidence gate: a near-identical match (>= DIRECT) reuses the saved answer with
# no model call; a strong match (>= ANSWER) uses the cheap Gemini model grounded
# in her knowledge; below that, the full Claude path runs. Higher = safer/rarer.
# KB_DIRECT_THRESHOLD=0.95
# KB_ANSWER_THRESHOLD=0.88

# --- The Interverse brain (brain/entities/ -> Tracy's context) ---
# Curated entities are injected when a message matches by name OR by meaning
# (embeddings; needs GEMINI_API_KEY + DATABASE_URL for the semantic layer).
# The server syncs entities into Postgres at boot; the daily brain loop can
# also push them live with: node scripts/brain-sync.js
# BRAIN_MIN_CONFIDENCE=0.7   # only entities at/above this are eligible
# BRAIN_MIN_SCORE=0.6        # semantic match threshold (query-to-summary cosine)
# BRAIN_MAX_ENTITIES=3       # max entities injected per message

# Conversation logging + per-user memory storage. Unset = local file fallback.
# On Render, set this to your Postgres INTERNAL Database URL.
# DATABASE_URL=postgresql://user:pass@host/db

# --- Access-key auth (optional) ---
# Set AUTH_SECRET to REQUIRE an access key to use /chat. Leave it unset to keep
# the site open. Use a long random string (e.g. `openssl rand -hex 32`).
# AUTH_SECRET=change-me-to-a-long-random-string
#
# Access keys people enter. Comma-separated. You can also generate managed,
# revocable keys into Postgres with: node scripts/genkey.js "label"
# Bind a key to a PERSON (verified identity + role, needed for the vault):
#   node scripts/genkey.js "Josh M" --user josh --role cto
# ACCESS_KEYS=tracy-aaaa-bbbb-cccc,tracy-dddd-eeee-ffff

# --- Code tasks (Tracy → Claude Code / Codex via scripts/agent-runner.js) ---
# The queue lives in Postgres (DATABASE_URL). These are read by the RUNNER, on
# the machine that has the repos + CLIs — not by the deployed server.
# AGENT_REPOS={"tracy-ai":"/abs/path/tracy-ai","partout":"/abs/path/PartOut"}
# AGENT_DEFAULT=claude          # agent used until the router has enough runs
# AGENT_MIN_SAMPLES=3           # runs per agent before stats drive routing
# AGENT_POLL_MS=15000
# AGENT_TIMEOUT_MS=1200000      # 20 min per task
# CLAUDE_ARGS=                  # extra flags for `claude -p`, e.g. --max-turns 40
# CODEX_ARGS=                   # extra flags for `codex exec`, e.g. -m gpt-5-codex
# AGENT_PRICING_JSON={"gpt-5-codex":{"in":1.25,"out":10}}   # Codex $/1M tokens

# --- Vault (optional; passing secrets between verified people) ---
# Set VAULT_SECRET to let Tracy store/hand off secrets (API keys, tokens)
# between people with identity-bound access keys. Secrets are AES-256-GCM
# encrypted with this value — use a long random string (`openssl rand -hex 32`)
# and NEVER commit it. Rotating it orphans previously stored secrets.
# Requires: AUTH_SECRET set (the gate on), and keys generated with --user.
# VAULT_SECRET=change-me-to-a-different-long-random-string

# Restrict which frontend origins may call the API (comma-separated). Unset = any.
# CORS_ORIGINS=https://tracy-ai.onrender.com

# --- Email (Tracy sends daily check-in digests) ---
# Provider for outbound email. resend (default) or sendgrid.
# EMAIL_PROVIDER=resend
# API key from your provider (https://resend.com or https://sendgrid.com).
# EMAIL_API_KEY=re_...
# Verified sender address. Must be a domain/sender you've verified with the provider.
# EMAIL_FROM=Tracy <tracy@yourdomain.com>

# --- Scheduled tasks (daily digest) ---
# Shared secret so ONLY your Render Cron Job can trigger POST /tasks/daily.
# Use a long random string. The cron sends it as the X-Tasks-Secret header.
# Run the cron FREQUENTLY (e.g. hourly) — each user is emailed once/day at their
# chosen local time. TASKS_SECRET=change-me-to-a-long-random-string
# Fallback timezone when a user's isn't known (IANA name).
# DEFAULT_TZ=America/New_York

# --- Push notifications (to phones/desktops — the installed app) ---
# Generate a keypair once:  node scripts/genvapid.js  (never commit the private key)
# Check-ins are delivered by email AND/OR push, whichever a user has set up.
# On iPhone, push only works for a PWA the user INSTALLED to their home screen.
# VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@yourdomain.com

# --- Admin surface (business stats) ---
# Only these Tracy userIds may use the admin tools (get_babyresell_stats, etc.).
# Find your userId in the app's Settings → User ID. Unset = admin tools refuse.
# ADMIN_USER_IDS=web-xxxxxxxx

# --- BabyResell connection (for the admin "how's it doing" tools) ---
# Deployed BabyResell backend base URL.
# BABYRESELL_API_URL=https://babyresell-backend.onrender.com
# Auth — pick ONE:
#  A) Service key (recommended): a read-only pass BabyResell recognizes. Set the
#     SAME value as TRACY_SERVICE_KEY on the BabyResell backend. No Mongo _id, no
#     shared JWT secret, no expiry.
# BABYRESELL_SERVICE_KEY=tracy-svc-...
#  B) Self-minted admin JWT: BABYRESELL_JWT_SECRET must equal BabyResell's
#     JWT_SECRET; the user id is an admin user's Mongo _id.
# BABYRESELL_JWT_SECRET=same-as-babyresell-backend-JWT_SECRET
# BABYRESELL_ADMIN_USER_ID=<admin user's Mongo _id>
#  C) Simple passthrough: an admin Bearer token (expires; refresh when it does).
# BABYRESELL_ADMIN_TOKEN=<admin JWT or Firebase token>
