{
  "name": "tracy-desktop",
  "productName": "Tracy",
  "version": "0.1.3",
  "description": "Tracy Desktop \u2014 Interverse's assistant as a full-time agent on your PC: runs her task runner and MCP tools in the tray, sets up Claude Code for you.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.js",
    "sync-skills": "node scripts/sync-skills.js",
    "test": "node --test test/*.test.js",
    "dist": "npm run stage && electron-builder --publish never",
    "dist:win": "npm run stage && electron-builder --win --publish never",
    "dist:mac": "npm run stage && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.interverse.tracy",
    "productName": "Tracy",
    "artifactName": "Tracy-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "ui/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staged",
        "to": "tracy"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/FabianB14/tracy-ai/releases/latest/download"
      }
    ]
  },
  "type": "module",
  "author": "Interverse",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabianB14/tracy-ai.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
